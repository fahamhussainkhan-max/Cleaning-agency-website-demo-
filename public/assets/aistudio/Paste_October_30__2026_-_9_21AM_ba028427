  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Responsive Mobile Menu Toggle
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileToggle = document.getElementById('mobile-toggle');
    function toggleMenu() {
      mobileMenu.classList.toggle('hidden');
    }
    mobileToggle.addEventListener('click', toggleMenu);

    // ================= MODAL LOGIC =================
    const bookingModal = document.getElementById('booking-modal');
    const bookingForm = document.getElementById('booking-form');
    const bookingSuccess = document.getElementById('booking-success');

    function openBookingModal() {
      bookingModal.classList.remove('hidden');
      bookingModal.classList.add('flex');
    }

    function closeBookingModal() {
      bookingModal.classList.add('hidden');
      bookingModal.classList.remove('flex');
      // Reset form
      bookingForm.classList.remove('hidden');
      bookingSuccess.classList.add('hidden');
    }

    function prefillBooking(serviceName) {
      const select = document.getElementById('modal-service');
      for (let i = 0; i < select.options.length; i++) {
        if (select.options[i].text.includes(serviceName) || select.options[i].value.includes(serviceName)) {
          select.selectedIndex = i;
          break;
        }
      }
      openBookingModal();
    }

    function handleFormSubmit(e) {
      e.preventDefault();
      bookingForm.classList.add('hidden');
      bookingSuccess.classList.remove('hidden');
      lucide.createIcons();
    }

    // ================= INTERACTIVE BEFORE/AFTER SLIDER =================
    const baContainer = document.getElementById('before-after-container');
    const beforeClip = document.getElementById('before-clip-layer');
    const sliderHandle = document.getElementById('slider-handle');
    let isDragging = false;

    function updateSlider(xPos) {
      const rect = baContainer.getBoundingClientRect();
      let offsetX = xPos - rect.left;
      if (offsetX < 0) offsetX = 0;
      if (offsetX > rect.width) offsetX = rect.width;
      
      const percent = (offsetX / rect.width) * 100;
      beforeClip.style.width = percent + '%';
      sliderHandle.style.left = percent + '%';
    }

    baContainer.addEventListener('mousedown', (e) => {
      isDragging = true;
      updateSlider(e.clientX);
    });

    window.addEventListener('mouseup', () => { isDragging = false; });
    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      updateSlider(e.clientX);
    });

    // Touch support for mobile devices
    baContainer.addEventListener('touchstart', (e) => {
      isDragging = true;
      updateSlider(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchend', () => { isDragging = false; });
    window.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      updateSlider(e.touches[0].clientX);
    }, { passive: true });

    // Ensure matching dimensions on the overlay image
    function syncImageWidth() {
      const beforeImage = document.getElementById('before-image');
      if (beforeImage && baContainer) {
        beforeImage.style.width = baContainer.offsetWidth + 'px';
      }
    }
    window.addEventListener('resize', syncImageWidth);
    syncImageWidth();

    // ================= LIVE PRICE CALCULATOR LOGIC =================
    let currentBase = 119;
    let currentDepthPrice = 0;
    const homeButtons = document.querySelectorAll('.home-type-btn');
    const depthRadios = document.querySelectorAll('.depth-radio');
    const addonCheckboxes = document.querySelectorAll('.calc-addon');
    const totalDisplay = document.getElementById('calc-total-display');

    function calculateTotal() {
      let addonSum = 0;
      addonCheckboxes.forEach(cb => {
        if (cb.checked) {
          addonSum += parseInt(cb.getAttribute('data-addon-price') || 0);
        }
      });
      const grandTotal = currentBase + currentDepthPrice + addonSum;
      totalDisplay.textContent = '$' + grandTotal;
    }

    homeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        homeButtons.forEach(b => {
          b.classList.remove('bg-brand-50', 'border-brand-600', 'text-brand-700');
          b.classList.add('text-slate-700');
        });
        btn.classList.add('bg-brand-50', 'border-brand-600', 'text-brand-700');
        currentBase = parseInt(btn.getAttribute('data-base'));
        calculateTotal();
      });
    });

    depthRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        currentDepthPrice = parseInt(e.target.value);
        calculateTotal();
      });
    });

    addonCheckboxes.forEach(cb => {
      cb.addEventListener('change', calculateTotal);
    });

    function bookWithEstimate() {
      openBookingModal();
    }

    // ================= GSAP ANIMATIONS & SCROLL COUNTER =================
    window.onload = function() {
      // Counter Animation
      const counters = document.querySelectorAll('.counter');
      counters.forEach(counter => {
        const target = +counter.getAttribute('data-target');
        gsap.to(counter, {
          innerText: target,
          duration: 2.2,
          ease: "power2.out",
          scrollTrigger: {
            trigger: "#stats-section",
            start: "top 80%",
            once: true
          },
          snap: { innerText: 1 }
        });
      });

      // 3D Card Hover Effect on Bento Grid
      const tiltCards = document.querySelectorAll('.tilt-card');
      tiltCards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          const rotateX = (-y / rect.height) * 8;
          const rotateY = (x / rect.width) * 8;
          card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        });

        card.addEventListener('mouseleave', () => {
          card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)`;
        });
      });
    };
  </script>
