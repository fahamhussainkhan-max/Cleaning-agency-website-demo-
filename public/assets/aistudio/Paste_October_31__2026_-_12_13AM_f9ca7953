  <!-- Scripts -->
  <script>
    lucide.createIcons();

    // 1. Smart Scroll Navbar (Mobile & Desktop Friendly)
    let lastScrollY = window.scrollY;
    const navbar = document.getElementById('navbar');

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      if (currentScrollY > 90 && currentScrollY > lastScrollY) {
        navbar.classList.add('nav-hidden');
      } else {
        navbar.classList.remove('nav-hidden');
      }
      lastScrollY = currentScrollY;
    }, { passive: true });

    // 2. Responsive Before/After Slider (Bug Free Touch & Mouse Drag)
    const frame = document.getElementById('sliderFrame');
    const container = document.getElementById('beforeContainer');
    const handle = document.getElementById('sliderHandle');
    const beforeImg = document.getElementById('beforeImg');
    let isDragging = false;

    function syncImageWidth() {
      if (frame && beforeImg) {
        beforeImg.style.width = `${frame.offsetWidth}px`;
      }
    }
    window.addEventListener('resize', syncImageWidth);
    window.addEventListener('load', syncImageWidth);

    function updateSlider(clientX) {
      const rect = frame.getBoundingClientRect();
      let pos = (clientX - rect.left) / rect.width;
      pos = Math.max(0, Math.min(1, pos));
      container.style.width = `${pos * 100}%`;
      handle.style.left = `${pos * 100}%`;
    }

    frame.addEventListener('pointerdown', (e) => {
      isDragging = true;
      frame.setPointerCapture(e.pointerId);
      updateSlider(e.clientX);
    });

    frame.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      updateSlider(e.clientX);
    });

    const stopDragging = (e) => {
      if (isDragging) {
        isDragging = false;
        try { frame.releasePointerCapture(e.pointerId); } catch(err){}
      }
    };
    frame.addEventListener('pointerup', stopDragging);
    frame.addEventListener('pointercancel', stopDragging);

    // 3. Live Price Calculation Logic
    let basePrice = 1999;
    let addonsTotal = 0;

    function updatePrice() {
      const total = basePrice + addonsTotal;
      document.getElementById('priceDisplay').innerText = total.toLocaleString('en-IN');
    }

    function setResidence(type, price, btn) {
      basePrice = price;
      document.querySelectorAll('.residence-btn').forEach(b => {
        b.classList.remove('border-gold-500', 'bg-gold-500/10', 'text-gold-300');
        b.classList.add('bg-noir-850', 'text-slate-300');
      });
      btn.classList.add('border-gold-500', 'bg-gold-500/10', 'text-gold-300');
      btn.classList.remove('bg-noir-850', 'text-slate-300');
      updatePrice();
    }

    function toggleAddon(cost, checkbox) {
      if (checkbox.checked) {
        addonsTotal += cost;
      } else {
        addonsTotal -= cost;
      }
      updatePrice();
    }

    // 4. Modal
    function toggleModal(show) {
      const modal = document.getElementById('bookingModal');
      modal.classList.toggle('hidden', !show);
    }

    function handleFormSubmit(e) {
      e.preventDefault();
      alert('Thank you! Your priority slot request has been recorded. Our concierge manager will call you shortly.');
      toggleModal(false);
    }

    // 5. FAQ Accordion Toggle
    function toggleFaq(btn) {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('[data-lucide="chevron-down"]');
      content.classList.toggle('hidden');
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    }

    // 6. GSAP Number Counting Animation
    gsap.registerPlugin(ScrollTrigger);
    document.querySelectorAll('.counter').forEach(counter => {
      const target = +counter.getAttribute('data-target');
      gsap.to(counter, {
        innerHTML: target,
        duration: 1.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: counter,
          start: 'top 85%'
        },
        snap: { innerHTML: 1 }
      });
    });
  </script>
